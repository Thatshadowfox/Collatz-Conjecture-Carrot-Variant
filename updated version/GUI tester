import math
import tkinter as tk
from tkinter import ttk, messagebox
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

# =====================================================================
# 1. CORE CARROT-COLLATZ ENGINE
# =====================================================================
def run_simulation(num, den, version, steps=15):
    n_hist, d_hist, val_hist, text_log = [num], [den], [num / den], []
    text_log.append(f"Step 0: Start Fraction = {num}/{den}")
    
    for step in range(1, steps + 1):
        cuts_num = num - 1
        cuts_den = den - 1
        
        if version == 0:
            total_cuts = cuts_num
            explanation = f"Num ({cuts_num} cuts)"
        elif version == 1:
            total_cuts = cuts_den
            explanation = f"Den ({cuts_den} cuts)"
        else:
            total_cuts = cuts_num + cuts_den
            explanation = f"Num ({cuts_num} cuts) + Den ({cuts_den} cuts) = {total_cuts} total cuts"
            
        is_even = (total_cuts % 2 == 0)
        parity_str = "Even" if is_even else "Odd"
        
        if version in [0, 1, 2]:
            if is_even:
                den = den * 2
                action = "Even Rule -> Divided fraction by 2 (D *= 2)"
            else:
                num = (3 * num) + den
                action = "Odd Rule -> Multiplied by 3, added 1 (N = 3N + D)"
        elif version == 3:
            if is_even:
                den = (3 * den) + 1
                action = "Even Rule -> Shifted Denominator (D = 3D + 1)"
            else:
                if num % 2 == 0:
                    num //= 2
                    action = "Odd Rule -> Numerator halved (N //= 2)"
                else:
                    den *= 2
                    action = "Odd Rule -> Denominator doubled (D *= 2)"
        elif version == 4:
            if is_even:
                num, den = den * 2, num
                action = "Even Rule -> Halved & Inverted (N, D = 2D, N)"
            else:
                num = (3 * num) - den
                action = "Odd Rule -> Matrix Transform (N = 3N - D)"
                
        if num == 0:
            text_log.append(f"Step {step}: 0/1 | {explanation} -> {parity_str} | {action} -> Hit Stable Zero")
            n_hist.append(0)
            d_hist.append(1)
            val_hist.append(0)
            break
            
        gcd = math.gcd(abs(num), abs(den))
        num //= gcd
        den //= gcd
        
        text_log.append(f"Step {step}: {num}/{den} | {explanation} -> {parity_str} | {action}")
        n_hist.append(num)
        d_hist.append(den)
        val_hist.append(num / den if den != 0 else 0)
        
        if abs(num) > 10**12 or abs(den) > 10**12:
            text_log.append("... Safety Threshold Exceeded (>10^12)!")
            break
            
    return n_hist, d_hist, val_hist, text_log

# =====================================================================
# 2. INTERACTIVE GUI APPLICATION
# =====================================================================
class InteractiveCarrotCollatzApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Carrot-Collatz Framework Laboratory")
        self.geometry("1100x700")
        self.minsize(700, 500)

        # Configure Main Grid
        self.grid_rowconfigure(1, weight=1)
        self.grid_columnconfigure(0, weight=1)

        # --- TOP CONTROL BAR ---
        self.top_panel = ttk.LabelFrame(self, text=" System Input Parameters ", padding=10)
        self.top_panel.grid(row=0, column=0, sticky="ew", padx=10, pady=5)

        ttk.Label(self.top_panel, text="Numerator (N):").grid(row=0, column=0, padx=5)
        self.ent_num = ttk.Entry(self.top_panel, width=8)
        self.ent_num.insert(0, "2")
        self.ent_num.grid(row=0, column=1, padx=5)

        ttk.Label(self.top_panel, text="Denominator (D):").grid(row=0, column=2, padx=5)
        self.ent_den = ttk.Entry(self.top_panel, width=8)
        self.ent_den.insert(0, "3")
        self.ent_den.grid(row=0, column=3, padx=5)

        ttk.Label(self.top_panel, text="Max Steps:").grid(row=0, column=4, padx=5)
        self.ent_steps = ttk.Entry(self.top_panel, width=8)
        self.ent_steps.insert(0, "15")
        self.ent_steps.grid(row=0, column=5, padx=5)

        btn_run = ttk.Button(self.top_panel, text="🚀 Run Simulation", command=self.update_simulation)
        btn_run.grid(row=0, column=6, padx=15)

        # --- MAIN WORKSPACE TAB CONTROL ---
        self.notebook = ttk.Notebook(self)
        self.notebook.grid(row=1, column=0, sticky="nsew", padx=10, pady=5)

        # Tab 1: Matplotlib Charts
        self.tab_graphs = ttk.Frame(self.notebook)
        self.notebook.add(self.tab_graphs, text="📈 Trajectory Visualizer")
        
        # Grid inside Graphs Tab
        self.tab_graphs.grid_rowconfigure(0, weight=1)
        self.tab_graphs.grid_columnconfigure(1, weight=1)

        # Side panel for view selection
        self.side_panel = ttk.Frame(self.tab_graphs, padding=10, relief="raised")
        self.side_panel.grid(row=0, column=0, sticky="ns")

        ttk.Label(self.side_panel, text="Select View:", font=("Helvetica", 10, "bold")).pack(anchor="w", pady=(0, 10))

        self.views = [
            "Version 0: Baseline Control",
            "Version 1: Absorbing Divergence Trap",
            "Version 2: Joint-Cut Absorbing Loop",
            "Version 3: Bounded Decay Funnel",
            "Version 4: Dual-Phase Reciprocal Oscillator",
            "Version 4: Phase Space Portrait"
        ]

        self.current_view = tk.StringVar(value=self.views[0])
        for v in self.views:
            rb = ttk.Radiobutton(self.side_panel, text=v, value=v, variable=self.current_view, command=self.render_chart)
            rb.pack(anchor="w", pady=5)

        # Canvas for Matplotlib
        self.plot_panel = ttk.Frame(self.tab_graphs)
        self.plot_panel.grid(row=0, column=1, sticky="nsew")
        self.fig, self.ax = plt.subplots(figsize=(6, 4))
        self.canvas = FigureCanvasTkAgg(self.fig, master=self.plot_panel)
        self.canvas.get_tk_widget().pack(fill="both", expand=True)

        # Tab 2: Detailed Text Inspector
        self.tab_logs = ttk.Frame(self.notebook)
        self.notebook.add(self.tab_logs, text="📋 Step-by-Step Math Inspector")
        
        self.txt_log = tk.Text(self.tab_logs, wrap="none", font=("Courier", 10))
        scroll_y = ttk.Scrollbar(self.tab_logs, orient="vertical", command=self.txt_log.yview)
        scroll_x = ttk.Scrollbar(self.tab_logs, orient="horizontal", command=self.txt_log.xview)
        self.txt_log.configure(yscrollcommand=scroll_y.set, xscrollcommand=scroll_x.set)
        
        scroll_y.pack(side="right", fill="y")
        scroll_x.pack(side="bottom", fill="x")
        self.txt_log.pack(side="left", fill="both", expand=True)

        # Run initial state
        self.update_simulation()

    def update_simulation(self):
        try:
            num = int(self.ent_num.get())
            den = int(self.ent_den.get())
            steps = int(self.ent_steps.get())

            if num <= 0 or den <= 0 or steps <= 0:
                raise ValueError("All values must be positive integers.")
        except ValueError as e:
            messagebox.showerror("Input Error", f"Invalid Input: {e}")
            return

        # Store simulation histories
        self.sim_data = {}
        self.all_logs = []

        for v in range(5):
            n_hist, d_hist, val_hist, log = run_simulation(num, den, version=v, steps=steps)
            self.sim_data[v] = (n_hist, d_hist, val_hist)
            self.all_logs.append(f"================ VERSION {v} SIMULATION LOG ================")
            self.all_logs.extend(log)
            self.all_logs.append("\n")

        # Update Inspector Text
        self.txt_log.delete("1.0", tk.END)
        self.txt_log.insert(tk.END, "\n".join(self.all_logs))

        # Render Active Chart
        self.render_chart()

    def render_chart(self):
        self.fig.clf()
        self.ax = self.fig.add_subplot(111)
        selected = self.current_view.get()

        if selected == "Version 0: Baseline Control":
            _, _, val = self.sim_data[0]
            self.ax.plot(val, marker='o', color='tab:blue', linewidth=2, label="Fraction N/D")
            self.ax.set_title("Version 0: Baseline Control (Clears to Whole Integers)", fontweight='bold')
            self.ax.set_ylabel("Fraction Value (N/D)")

        elif selected == "Version 1: Absorbing Divergence Trap":
            n, d, _ = self.sim_data[1]
            self.ax.plot(n, marker='o', label='Numerator (N)', color='tab:red')
            self.ax.plot(d, marker='s', label='Denominator (D)', color='tab:gray', linestyle='--')
            self.ax.set_yscale('log')
            self.ax.set_title("Version 1: Absorbing Divergence Trap (Escapes N -> ∞)", fontweight='bold')
            self.ax.set_ylabel("Value (Log Scale)")

        elif selected == "Version 2: Joint-Cut Absorbing Loop":
            n, d, _ = self.sim_data[2]
            self.ax.plot(n, marker='o', label='Numerator (N)', color='tab:purple')
            self.ax.plot(d, marker='s', label='Denominator (D)', color='tab:gray', linestyle='--')
            self.ax.set_yscale('log')
            self.ax.set_title("Version 2: Joint-Cut Absorbing Loop (Locks D=2, Escapes N -> ∞)", fontweight='bold')
            self.ax.set_ylabel("Value (Log Scale)")

        elif selected == "Version 3: Bounded Decay Funnel":
            n, d, _ = self.sim_data[3]
            self.ax.plot(n, marker='o', label='Numerator (N)', color='tab:green')
            self.ax.plot(d, marker='s', label='Denominator (D)', color='tab:orange')
            self.ax.set_title("Version 3: Bounded Decay Funnel", fontweight='bold')
            self.ax.set_ylabel("Component Values")

        elif selected == "Version 4: Dual-Phase Reciprocal Oscillator":
            _, _, val = self.sim_data[4]
            self.ax.plot(val, marker='o', color='tab:red', linewidth=2, label="Fraction N/D")
            self.ax.axhline(y=1.0, color='black', linestyle=':', label='Boundary Line (N=D)')
            self.ax.set_yscale('log')
            self.ax.set_title("Version 4: Dual-Phase Reciprocal Oscillator (Log Scale)", fontweight='bold')
            self.ax.set_ylabel("Fraction Value (Log Scale)")

        elif selected == "Version 4: Phase Space Portrait":
            n, d, _ = self.sim_data[4]
            self.ax.plot(n, d, marker='o', color='tab:olive', alpha=0.7, label="Trajectory Path")
            max_val = max(max(n), max(d)) if n and d else 1
            self.ax.plot([0, max_val], [0, max_val], color='gray', linestyle='--', label='Main Diagonal (Y=X)')
            self.ax.set_title("Version 4: Phase Space Portrait (N vs D)", fontweight='bold')
            self.ax.set_xlabel("Numerator (N)")
            self.ax.set_ylabel("Denominator (D)")

        self.ax.set_xlabel("Step Count") if selected != "Version 4: Phase Space Portrait" else None
        self.ax.legend()
        self.ax.grid(True, linestyle='--', alpha=0.5)
        self.fig.tight_layout()
        self.canvas.draw()

if __name__ == "__main__":
    app = InteractiveCarrotCollatzApp()
    app.mainloop()